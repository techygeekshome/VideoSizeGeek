<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoSizeGeek.ViewModels"
        x:Class="VideoSizeGeek.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VideoSizeGeek"
        Width="720" Height="760" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Navy}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <StyleInclude Source="avares://VideoSizeGeek/Themes/Shell.axaml" />
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="24,18" Background="{StaticResource Chrome}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Grid.Column="0" Source="avares://VideoSizeGeek/Assets/videosizegeek.png"
               Width="34" Height="34" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="VideoSizeGeek" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="Fits a video into a size limit, exactly" FontSize="11.5"
                     Foreground="{StaticResource Txt3}" Margin="0,1,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Classes="ghost" Content="About"
                Command="{Binding ShowAboutCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24" Spacing="16">

        <!-- ffmpeg missing -->
        <Border Classes="band" Background="#332A1A0A" BorderBrush="{StaticResource Amber}"
                IsVisible="{Binding !FfmpegAvailable}">
          <StackPanel Spacing="8">
            <TextBlock Text="ffmpeg is not installed" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
            <TextBlock Text="{Binding FfmpegMissingMessage}" TextWrapping="Wrap" Classes="sub" />
          </StackPanel>
        </Border>

        <!-- drop zone, shown until a file is loaded -->
        <Border Classes="drop" IsVisible="{Binding !HasSource}" Height="150">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="Drop a video here" FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="or" Classes="sub" HorizontalAlignment="Center" />
            <Button Classes="primary" Content="Choose a file..."
                    Command="{Binding PickFileCommand}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- loaded file -->
        <Border Classes="card" IsVisible="{Binding HasSource}">
          <Grid ColumnDefinitions="*,Auto" Margin="16">
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding SourceFileName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DurationText}" Classes="sub" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Choose a different file"
                    Command="{Binding PickFileCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- target -->
        <Border Classes="card" IsVisible="{Binding HasSource}">
          <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="Target size" FontWeight="SemiBold" />

            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                      HorizontalAlignment="Stretch" />

            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsCustomSize}">
              <TextBlock Text="Megabytes:" VerticalAlignment="Center" Classes="sub" />
              <NumericUpDown Value="{Binding CustomMegabytes}" Minimum="0.5" Maximum="4096"
                              Increment="1" FormatString="0.#" Width="140" />
            </StackPanel>

            <CheckBox Content="Keep audio" IsChecked="{Binding IncludeAudio}" />

            <TextBlock Text="{Binding PlanSummary}" Classes="mono sub"
                        IsVisible="{Binding PlanSummary.Length}" />

            <Border Classes="band" Background="#332A1A0A" BorderBrush="{StaticResource Amber}"
                    IsVisible="{Binding ShowFloorWarning}">
              <TextBlock Text="{Binding FloorWarning}" TextWrapping="Wrap"
                          Foreground="{StaticResource Amber}" FontSize="12.5" />
            </Border>
          </StackPanel>
        </Border>

        <!-- go -->
        <StackPanel Spacing="10" IsVisible="{Binding HasSource}">
          <Button Classes="primary" Content="Shrink it" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Command="{Binding StartCommand}" />
          <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1"
                        Height="6" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding StatusText}" Classes="sub"
                      IsVisible="{Binding StatusText.Length}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- result -->
        <Border Classes="card" IsVisible="{Binding HasResult}">
          <Grid ColumnDefinitions="*,Auto" Margin="16">
            <StackPanel Grid.Column="0">
              <TextBlock Text="Done" FontWeight="SemiBold" Foreground="{StaticResource GreenLight}" />
              <TextBlock Text="{Binding StatusText}" Classes="sub" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="toolbtn" Content="Show in folder"
                    Click="OnRevealResult" VerticalAlignment="Center" />
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
