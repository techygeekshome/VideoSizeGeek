<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>TechyGeeksHome</Company>
    <Authors>TechyGeeksHome</Authors>
    <Copyright>Copyright (c) 2026 TechyGeeksHome</Copyright>
    <!-- Bump this and the git tag together. AppGeek shipped a v1.0.1 tag with 1.0.0 binaries
         once already because nothing here connected the two; see
         claude/appgeek-release-versioning-fix-aug-2026.md. Same manual discipline CutGeek,
         VideoSizeGeek and the rest of the range already run on. -->
        <Version>1.0.1</Version>
  </PropertyGroup>
</Project>
